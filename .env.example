# Copy to .env. AI providers are tried IN THIS ORDER for every AI call. If one fails (bad key, retired
# model, quota, timeout, network) the next one answers. If all fail - or no key is set - the app shows
# "No AI involved" and keeps working on deterministic rules only. Only open-weight models are used.
LLM_PROVIDERS=groq,openrouter

# --- A: Groq (free tier, fast) - https://console.groq.com/keys --------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- B: OpenRouter - https://openrouter.ai/keys ---------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- C: fully local via Ollama (add "ollama" to LLM_PROVIDERS; ollama pull qwen2.5:7b) --------------
# OLLAMA_MODEL=qwen2.5:7b

# Set LLM_PROVIDERS=none to switch AI off completely.

# Optional tuning
# LLM_TIMEOUT=30                     # seconds per AI call before falling back
# LLM_RETRY_TRANSIENT_AFTER=60       # skip a provider this long after a 429 / 5xx / timeout
# LLM_RETRY_PERMANENT_AFTER=900      # ...and this long after a bad key / retired model

# Pace of the agent so a human can watch it work (seconds per step). 0 = full speed.
AGENT_STEP_DELAY=0.35
AGENT_PUSH_DELAY=0.04

# Point the push step at a real target API. Unset = the stub mounted in this same process, so the app works on
# any port without extra configuration.
# TARGET_API_URL=http://127.0.0.1:8001
